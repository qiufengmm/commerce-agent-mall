# =============================================================================
# Mall 本地 Docker Compose 环境变量模板
# =============================================================================
# 使用方式（PowerShell）：
#   Copy-Item .env.example .env
#   powershell -ExecutionPolicy Bypass -File document\docker\check-env.ps1
# 然后按注释修改 .env 中的占位符，直到校验脚本返回 0。
#
# 安全约定：
# 1. 本文件只放变量名和安全占位符，禁止填写任何真实密码、Token、密钥、
#    支付宝配置或生产地址。
# 2. .env 已被 .gitignore 忽略（**/.env），不要提交填写后的文件。
# 3. 所有 <...> 形式的占位符都必须替换；带 :? 约束的变量缺失时
#    docker compose 会直接报错，不会静默使用空密码启动。
# 4. docker compose config --quiet 只能验证 YAML 与变量渲染，
#    不能代替凭据安全校验，必须先跑 check-env.ps1。
# 5. 默认所有发布端口只绑定 127.0.0.1；只有 MINIO_BIND_ADDR 与
#    NGINX_BIND_ADDR 支持按服务 opt-in 改为 0.0.0.0。
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
# 可选覆盖镜像标签，例如网络环境需要固定版本时改为 mysql:5.7.x
MYSQL_IMAGE=mysql:5.7
# 本地开发库 root 密码，占位符，必须替换为自己的值
MYSQL_ROOT_PASSWORD=<请填写本地 MySQL root 密码>
# 应用连接的库名，初始化 SQL 会写入该库
MYSQL_DATABASE=mall
# 宿主机映射端口（绑定 127.0.0.1）
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Redis（本地无认证，只绑定 127.0.0.1，不提供整体暴露开关）
# -----------------------------------------------------------------------------
REDIS_IMAGE=redis:7
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
# 应用使用的账号，镜像会自动创建并授予 vhost 权限
RABBITMQ_USERNAME=mall
RABBITMQ_PASSWORD=<请填写本地 RabbitMQ 密码>
# mall-portal 现有配置使用的 vhost，必须与之一致
RABBITMQ_VHOST=/mall
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# MongoDB（mall-portal 的浏览历史、收藏、关注）
# -----------------------------------------------------------------------------
MONGO_IMAGE=mongo:7
# 与 mall-portal/application-dev.yml 中 spring.data.mongodb.database 保持一致
MONGO_DATABASE=mall-port
MONGO_PORT=27017

# -----------------------------------------------------------------------------
# Elasticsearch
# -----------------------------------------------------------------------------
# 与本地 Maven 依赖 co.elastic.clients:elasticsearch-java:8.18.8 对齐
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.18.8
ES_PORT=9200
# ES 堆内存，内存紧张时改为 -Xms512m -Xmx512m
ES_JAVA_OPTS=-Xms1g -Xmx1g

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
# 固定版本标签，统一从官方 Quay 仓库拉取（quay.io/minio/minio、quay.io/minio/mc）
# 这两个标签已分别完成拉取验证；如目标网络无法访问 Quay，
# 可在本机 .env 覆盖为可用镜像，或使用 docker image load 离线导入
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-05-21T01-59-54Z
MINIO_ROOT_USER=<请填写 MinIO root 用户>
MINIO_ROOT_PASSWORD=<请填写 MinIO root 密码>
# 应用使用的 bucket，minio-init 会在启动时创建（如不存在）
MINIO_BUCKET_NAME=mall
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# mall-admin 返回给浏览器的图片/文件访问地址（公开地址）。
# 只用于拼接上传接口返回的 URL，不作为 MinIO SDK 连接地址
# （SDK 始终使用容器内部地址 MINIO_ENDPOINT=http://minio:9000）。
# 必须是浏览器能解析的地址，禁止写成 Docker 服务名 http://minio:9000。
# 默认 localhost:9000：本机浏览器访问正常，手机 / 微信开发者工具无法访问。
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# 手机 / 微信开发者工具联调时：把上面一行改成宿主机局域网地址，例如
#   MINIO_PUBLIC_ENDPOINT=http://192.168.1.20:9000
# 并同时设置 MINIO_BIND_ADDR=0.0.0.0，否则手机连不上 9000 端口。
# 注意：Redis、MongoDB、Elasticsearch 本地无认证，不允许暴露到局域网，
#       配置文件中也不存在把它们整体暴露到 0.0.0.0 的开关。
# 唯一允许改成 0.0.0.0 的按服务 opt-in 绑定地址（手机/微信开发者工具联调时使用）
# 默认 127.0.0.1；改成 0.0.0.0 会把 MinIO 控制台与 API 暴露到局域网，请自行评估风险
MINIO_BIND_ADDR=127.0.0.1

# -----------------------------------------------------------------------------
# 应用服务（app profile）
# -----------------------------------------------------------------------------
# mall-admin 与 mall-search 共用的内部同步令牌，占位符
# 生成示例（PowerShell，32 字节十六进制）：
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
# 未配置/不一致时的行为：
#   mall-search 六条写路径（importAll、create/{id}、delete/{id}、delete/batch、
#   sync/{id}、sync/batch）返回 401（令牌缺失/错误）或 503（服务端未配置）；
#   mall-admin 跳过同步并记录 warn 日志，不影响商品主流程
# 只读接口（search、search/simple、search/relate、recommend/{id}）保持匿名可访问
MALL_SEARCH_INTERNAL_TOKEN=<请生成本地随机令牌>

# mall-search importAll 的跨实例 Redis 互斥锁；生产环境保持开启，调试时不要关闭保护。
MALL_SEARCH_IMPORT_LOCK_ENABLED=true
MALL_SEARCH_IMPORT_LOCK_KEY=mall:search:import-all
MALL_SEARCH_IMPORT_LOCK_LEASE_SECONDS=1800
MALL_SEARCH_IMPORT_LOCK_RENEW_INTERVAL_SECONDS=30

# 门户 mall-portal 的MySQL降级搜索开关，默认 false（关闭）。
# 关闭时：mall-search 调用失败会把异常原样暴露，不静默查询MySQL。
# 开启时：mall-search 调用失败才降级到MySQL商品读查询，只做读查询，
#        不改变筛选条件与1-based分页契约，且不具备ES相关度排序能力。
# 注意：ES正常时即使开启也不会查询MySQL。
MALL_SEARCH_MYSQL_FALLBACK_ENABLED=false

# -----------------------------------------------------------------------------
# app profile：商品导购智能体（mall-shopping-agent）
# -----------------------------------------------------------------------------
# 只读调用 mall-portal 的五个接口，不直连任何数据库或中间件。
# 模型模式：openai（默认，需要真实 Key）或 stub（无 Key 离线演示）
MALL_AGENT_MODEL_MODE=openai
# OpenAI 兼容服务地址，必须包含 /v1；服务端会据此拼接 /chat/completions
MALL_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# 兼容服务必须支持 tools / tool_choice / tool_calls，且返回非流式响应
MALL_AGENT_OPENAI_MODEL=<请填写模型名>
# 只放在本机 .env 或进程环境变量中，不要提交；占位值会被服务端与校验脚本拒绝
MALL_AGENT_OPENAI_API_KEY=<请填写模型服务 API Key>
# 单次回答最大工具轮数（1..8）
MALL_AGENT_MAX_TOOL_ROUNDS=4
# 会话有效期（秒），默认 24 小时
MALL_AGENT_SESSION_TTL_SECONDS=86400
# 日志级别：CRITICAL / ERROR / WARNING / INFO / DEBUG
MALL_AGENT_LOG_LEVEL=INFO
# 宿主机映射端口（绑定 127.0.0.1）
AGENT_PORT=8086
# 智能体镜像标签，固定为本地构建产物
AGENT_IMAGE=mall-local/mall-shopping-agent:local

ADMIN_PORT=8080
SEARCH_PORT=8081
PORTAL_PORT=8085
# Spring 激活的 profile
SPRING_PROFILES_ACTIVE=dev
# 容器 JVM 参数
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
# 构建出的本地镜像前缀，不依赖不存在的 mall/*:1.0-SNAPSHOT
APP_IMAGE_PREFIX=mall-local

# -----------------------------------------------------------------------------
# 宿主机直接运行 Java 服务时使用（容器内部由 Compose 覆盖为服务名）
# -----------------------------------------------------------------------------
HOST_MYSQL_HOST=localhost
HOST_REDIS_HOST=localhost
HOST_RABBITMQ_HOST=localhost
HOST_MONGO_HOST=localhost
HOST_ELASTICSEARCH_URIS=http://localhost:9200
HOST_MINIO_ENDPOINT=http://localhost:9000
HOST_MALL_SEARCH_BASE_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Nginx（edge profile）
# -----------------------------------------------------------------------------
NGINX_IMAGE=nginx:1.27-alpine
# 避免与 mall-admin 的 8080 冲突
NGINX_HTTP_PORT=8088
# 唯一另一个允许改成 0.0.0.0 的按服务 opt-in 绑定地址
NGINX_BIND_ADDR=127.0.0.1
# 已构建好的前端静态资源目录，相对于仓库根
ADMIN_WEB_DIST_DIR=./mall-admin-web-master/dist
H5_WEB_DIST_DIR=./mall-app-web-master/dist/build/h5

# -----------------------------------------------------------------------------
# 可观测组件（observability profile）
# -----------------------------------------------------------------------------
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.18.8
KIBANA_PORT=5601
LOGSTASH_IMAGE=docker.elastic.co/logstash/logstash:8.18.3
# 应用侧 logstash.host，指向 Compose 服务名
LOGSTASH_HOST=logstash
# 开发配置默认关闭 Logstash 输出，需要采集日志时改为 true
LOGSTASH_ENABLEINNERLOG=false
