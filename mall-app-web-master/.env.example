# 前端环境变量示例（占位配置，复制为 .env.* 后按本机联调环境填写）
# 注意：不要提交包含真实 IP、密码、Token、AccessKey 的 .env 文件

# 页面标题
VITE_APP_TITLE=Mall商城

# 接口基础地址
# H5 开发（Vite 代理）：/api
# 微信开发者工具/真机：http://<LAN_IP>:8085
# Nginx 代理：http://<LAN_IP>:8088/portal-api
VITE_API_BASE_URL=/api

# MinIO 公开访问地址，用于把后端返回的内部图片地址（localhost/127.0.0.1/minio:9000）
# 重写成手机可访问的局域网地址，示例值中的 <LAN_IP> 请替换为宿主机局域网 IP
VITE_MINIO_PUBLIC_ENDPOINT=http://<LAN_IP>:9000

# H5 端是否启用支付宝支付
VITE_USE_ALIPAY=false
